{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "petfish-style-rewriter": "allow",
      "ppt-reader": "allow",
      "ppt-writer": "allow",
      "fish-trail": "allow"
    }
  },
  "plugin": [
    [".opencode/plugin/system-prompt-rules.ts", {}],
    [".opencode/plugin/fish-trail-compaction.ts", {}],
    [".opencode/plugin/topic-context-filter.ts", { "enabled": true, "safetyWindow": 3, "minMessages": 10 }]
  ],
  "mcp": {
    "context-state": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "python",
        ".opencode/skills/fish-trail/mcp/context-state/server.py"
      ]
    }
  }
}
